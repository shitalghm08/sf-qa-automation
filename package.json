{
  "name": "sf-qa-automation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Playwright + TypeScript UI automation for Salesforce CRM (Lead -> Opportunity conversion)",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --project=webkit-smoke --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:negative": "playwright test --project=chromium --grep @negative",
    "test:headed": "playwright test --project=chromium --headed",
    "test:fresh-login": "cross-env RUN_FRESH_LOGIN=1 playwright test --project=fresh-login --workers=1",
    "signup:fill": "cross-env SF_SIGNUP=1 playwright test tests/auth/signup.spec.ts --project=signup --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.56.0",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "typescript": "^5.6.0"
  }
}
